   <!-- ════════════════════════════════════════════════════════════ -->
   <!-- Group 7: Test Status                                       -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:Test Status">
      <obj_property name="label">Test Status</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/reset_done_seen" type="logic">
