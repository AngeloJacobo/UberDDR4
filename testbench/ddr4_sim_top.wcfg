   <!-- Group 3: DFI Control (Controller → PHY)                    -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:DFI Control">
      <obj_property name="label">DFI Control (Controller → PHY)</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_cs_n" type="array">
         <obj_property name="ElementShortName">o_dfi_cs_n[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_cs_n[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_act_n" type="array">
         <obj_property name="ElementShortName">o_dfi_act_n[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_act_n[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_ras_n" type="array">
         <obj_property name="ElementShortName">o_dfi_ras_n[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_ras_n[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_cas_n" type="array">
         <obj_property name="ElementShortName">o_dfi_cas_n[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_cas_n[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_we_n" type="array">
         <obj_property name="ElementShortName">o_dfi_we_n[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_we_n[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_cke" type="array">
         <obj_property name="ElementShortName">o_dfi_cke[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_cke[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_reset_n" type="array">
         <obj_property name="ElementShortName">o_dfi_reset_n[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_reset_n[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_odt" type="array">
         <obj_property name="ElementShortName">o_dfi_odt[3:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_odt[3:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_address" type="array">
         <obj_property name="ElementShortName">o_dfi_address[67:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_address[67:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_bank" type="array">
         <obj_property name="ElementShortName">o_dfi_bank[7:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_bank[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_bg" type="array">
         <obj_property name="ElementShortName">o_dfi_bg[7:0]</obj_property>
         <obj_property name="ObjectShortName">o_dfi_bg[7:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_init_start" type="logic">
         <obj_property name="ElementShortName">o_dfi_init_start</obj_property>
         <obj_property name="ObjectShortName">o_dfi_init_start</obj_property>
      </wvobject>
   </wvobject>

   <!-- ════════════════════════════════════════════════════════════ -->
   <!-- Group 4: DFI Status & Training                             -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:DFI Status &amp; Training">
      <obj_property name="label">DFI Status &amp; Training</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/u_dut/dfi_init_start" type="logic">
         <obj_property name="ElementShortName">dfi_init_start</obj_property>
         <obj_property name="ObjectShortName">dfi_init_start</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/dfi_init_complete" type="logic">
         <obj_property name="ElementShortName">dfi_init_complete</obj_property>
         <obj_property name="ObjectShortName">dfi_init_complete</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_rdlvl_en" type="logic">
         <obj_property name="ElementShortName">o_dfi_rdlvl_en</obj_property>
         <obj_property name="ObjectShortName">o_dfi_rdlvl_en</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_rdlvl_gate_en" type="logic">
         <obj_property name="ElementShortName">o_dfi_rdlvl_gate_en</obj_property>
         <obj_property name="ObjectShortName">o_dfi_rdlvl_gate_en</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_wrlvl_en" type="logic">
         <obj_property name="ElementShortName">o_dfi_wrlvl_en</obj_property>
         <obj_property name="ObjectShortName">o_dfi_wrlvl_en</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/o_dfi_wrlvl_strobe" type="logic">
         <obj_property name="ElementShortName">o_dfi_wrlvl_strobe</obj_property>
         <obj_property name="ObjectShortName">o_dfi_wrlvl_strobe</obj_property>
      </wvobject>
   </wvobject>

   <!-- ════════════════════════════════════════════════════════════ -->
   <!-- Group 5: DDR4 Interface (PHY → SDRAM)                      -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:DDR4 Interface (PHY → SDRAM)">
      <obj_property name="label">DDR4 Interface (PHY → SDRAM)</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/ddr4_ck_p" type="logic">
         <obj_property name="ElementShortName">ddr4_ck_p</obj_property>
         <obj_property name="ObjectShortName">ddr4_ck_p</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_ck_n" type="logic">
         <obj_property name="ElementShortName">ddr4_ck_n</obj_property>
         <obj_property name="ObjectShortName">ddr4_ck_n</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_reset_n" type="logic">
         <obj_property name="ElementShortName">ddr4_reset_n</obj_property>
         <obj_property name="ObjectShortName">ddr4_reset_n</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_cke" type="logic">
         <obj_property name="ElementShortName">ddr4_cke</obj_property>
         <obj_property name="ObjectShortName">ddr4_cke</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_cs_n" type="logic">
         <obj_property name="ElementShortName">ddr4_cs_n</obj_property>
         <obj_property name="ObjectShortName">ddr4_cs_n</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_act_n" type="logic">
         <obj_property name="ElementShortName">ddr4_act_n</obj_property>
         <obj_property name="ObjectShortName">ddr4_act_n</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_addr" type="array">
         <obj_property name="ElementShortName">ddr4_addr[16:0]</obj_property>
         <obj_property name="ObjectShortName">ddr4_addr[16:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_ba" type="array">
