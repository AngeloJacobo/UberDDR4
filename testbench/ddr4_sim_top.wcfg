   <!-- ════════════════════════════════════════════════════════════ -->
   <!-- Group 6: DDR4 Data Path                                    -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:DDR4 Data Path">
      <obj_property name="label">DDR4 Data Path</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/ddr4_dq" type="array">
