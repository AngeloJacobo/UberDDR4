         <obj_property name="ObjectShortName">ddr4_dq[15:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ddr4_dqs_p" type="array">
         <obj_property name="ElementShortName">ddr4_dqs_p[1:0]</obj_property>
         <obj_property name="ObjectShortName">ddr4_dqs_p[1:0]</obj_property>
         <obj_property name="Radix">BINARYRADIX</obj_property>
