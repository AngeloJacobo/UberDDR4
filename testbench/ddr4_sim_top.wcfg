<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="ddr4_sim_top_behav.wdb" id="1">
         <top_modules>
            <top_module name="ddr4_sim_top" />
            <top_module name="glbl" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"/>
      <ZoomEndTime time="10000000 ps"/>
      <Cursor1Time time="0 ps"/>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="220"/>
      <ValueColumnWidth column_width="100"/>
   </column_width_setting>
   <WVObjectSize size="50" />

   <!-- ════════════════════════════════════════════════════════════ -->
   <!-- Group 1: Clocks & Reset                                     -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:Clocks &amp; Reset">
      <obj_property name="label">Clocks &amp; Reset</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/ddr4_clk" type="logic">
         <obj_property name="ElementShortName">ddr4_clk</obj_property>
         <obj_property name="ObjectShortName">ddr4_clk</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/controller_clk" type="logic">
         <obj_property name="ElementShortName">controller_clk</obj_property>
         <obj_property name="ObjectShortName">controller_clk</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/ref_clk" type="logic">
         <obj_property name="ElementShortName">ref_clk</obj_property>
         <obj_property name="ObjectShortName">ref_clk</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/rst_n" type="logic">
         <obj_property name="ElementShortName">rst_n</obj_property>
         <obj_property name="ObjectShortName">rst_n</obj_property>
      </wvobject>
   </wvobject>

   <!-- ════════════════════════════════════════════════════════════ -->
   <!-- Group 2: Debug Decode (human-readable ASCII strings)        -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:Debug Decode">
      <obj_property name="label">Debug Decode</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/dbg_rom_phase" type="array">
         <obj_property name="ElementShortName">dbg_rom_phase[127:0]</obj_property>
         <obj_property name="ObjectShortName">dbg_rom_phase[127:0]</obj_property>
         <obj_property name="Radix">ASCIIRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/dbg_dfi_cmd" type="array">
         <obj_property name="ElementShortName">dbg_dfi_cmd[63:0]</obj_property>
         <obj_property name="ObjectShortName">dbg_dfi_cmd[63:0]</obj_property>
         <obj_property name="Radix">ASCIIRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/dbg_ddr4_cmd" type="array">
         <obj_property name="ElementShortName">dbg_ddr4_cmd[63:0]</obj_property>
         <obj_property name="ObjectShortName">dbg_ddr4_cmd[63:0]</obj_property>
         <obj_property name="Radix">ASCIIRADIX</obj_property>
      </wvobject>
   </wvobject>

   <!-- ════════════════════════════════════════════════════════════ -->
   <!-- Group 3: Init ROM (Controller Internals)                    -->
   <!-- ════════════════════════════════════════════════════════════ -->
   <wvobject type="group" fp_name="group:Init ROM (Controller)">
      <obj_property name="label">Init ROM (Controller)</obj_property>
      <obj_property name="isExpanded"/>

      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/instruction_address" type="array">
         <obj_property name="ElementShortName">instruction_address[5:0]</obj_property>
         <obj_property name="ObjectShortName">instruction_address[5:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/delay_counter" type="array">
         <obj_property name="ElementShortName">delay_counter</obj_property>
         <obj_property name="ObjectShortName">delay_counter</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/delay_counter_is_zero" type="logic">
         <obj_property name="ElementShortName">delay_counter_is_zero</obj_property>
         <obj_property name="ObjectShortName">delay_counter_is_zero</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/pause_counter" type="logic">
         <obj_property name="ElementShortName">pause_counter</obj_property>
         <obj_property name="ObjectShortName">pause_counter</obj_property>
      </wvobject>
      <wvobject fp_name="/ddr4_sim_top/u_dut/u_controller/reset_done" type="logic">
         <obj_property name="ElementShortName">reset_done</obj_property>
         <obj_property name="ObjectShortName">reset_done</obj_property>
      </wvobject>
   </wvobject>

