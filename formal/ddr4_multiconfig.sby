[tasks]
ddr4_1600_x4_map0
ddr4_1600_x4_map1
ddr4_1600_x8_map0
ddr4_1600_x8_map1
ddr4_1600_x16_map0
ddr4_1600_x16_map1
ddr4_1866_x4_map0
ddr4_1866_x4_map1
ddr4_1866_x8_map0
ddr4_1866_x8_map1
ddr4_1866_x16_map0
ddr4_1866_x16_map1
ddr4_2133_x4_map0
ddr4_2133_x4_map1
ddr4_2133_x8_map0
ddr4_2133_x8_map1
ddr4_2133_x16_map0
ddr4_2133_x16_map1
