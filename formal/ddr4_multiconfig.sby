ddr4_1600_x16_map0_bounded
ddr4_2400_x8_row14_map1
ddr4_2400_x8_row17_map1

[options]
mode prove
depth 8
ddr4_1600_x8_map1_bounded: mode prove
ddr4_1600_x8_map1_bounded: depth 28
ddr4_2400_x8_map1_bounded: mode prove
ddr4_2400_x8_map1_bounded: depth 28
ddr4_2400_x16_map1_bounded: mode prove
ddr4_2400_x16_map1_bounded: depth 28
ddr4_1600_x16_map0_bounded: mode prove
ddr4_1600_x16_map0_bounded: depth 28

[engines]
smtbmc

[script]
ddr4_1600_x4_map0:  read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=4  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_1600_x4_map1:  read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=4  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_1600_x8_map0:  read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=8  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_1600_x8_map1:  read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_1600_x16_map0: read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=16 -DADDR_MAPPING=0 ddr4_controller.v
ddr4_1600_x16_map1: read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=16 -DADDR_MAPPING=1 ddr4_controller.v
ddr4_1866_x4_map0:  read -formal -DDDR4_CLK_PERIOD=1071 -DDEVICE_WIDTH=4  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_1866_x4_map1:  read -formal -DDDR4_CLK_PERIOD=1071 -DDEVICE_WIDTH=4  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_1866_x8_map0:  read -formal -DDDR4_CLK_PERIOD=1071 -DDEVICE_WIDTH=8  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_1866_x8_map1:  read -formal -DDDR4_CLK_PERIOD=1071 -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_1866_x16_map0: read -formal -DDDR4_CLK_PERIOD=1071 -DDEVICE_WIDTH=16 -DADDR_MAPPING=0 ddr4_controller.v
ddr4_1866_x16_map1: read -formal -DDDR4_CLK_PERIOD=1071 -DDEVICE_WIDTH=16 -DADDR_MAPPING=1 ddr4_controller.v
ddr4_2133_x4_map0:  read -formal -DDDR4_CLK_PERIOD=937  -DDEVICE_WIDTH=4  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_2133_x4_map1:  read -formal -DDDR4_CLK_PERIOD=937  -DDEVICE_WIDTH=4  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_2133_x8_map0:  read -formal -DDDR4_CLK_PERIOD=937  -DDEVICE_WIDTH=8  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_2133_x8_map1:  read -formal -DDDR4_CLK_PERIOD=937  -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_2133_x16_map0: read -formal -DDDR4_CLK_PERIOD=937  -DDEVICE_WIDTH=16 -DADDR_MAPPING=0 ddr4_controller.v
ddr4_2133_x16_map1: read -formal -DDDR4_CLK_PERIOD=937  -DDEVICE_WIDTH=16 -DADDR_MAPPING=1 ddr4_controller.v
ddr4_2400_x4_map0:  read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=4  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_2400_x4_map1:  read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=4  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_2400_x8_map0:  read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=8  -DADDR_MAPPING=0 ddr4_controller.v
ddr4_2400_x8_map1:  read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 ddr4_controller.v
ddr4_2400_x16_map0: read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=16 -DADDR_MAPPING=0 ddr4_controller.v
ddr4_2400_x16_map1: read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=16 -DADDR_MAPPING=1 ddr4_controller.v
ddr4_1600_x8_map1_bounded:  read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 -DFORMAL_BOUNDED_STALL ddr4_controller.v
ddr4_2400_x8_map1_bounded:  read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 -DFORMAL_BOUNDED_STALL ddr4_controller.v
ddr4_2400_x16_map1_bounded: read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=16 -DADDR_MAPPING=1 -DFORMAL_BOUNDED_STALL ddr4_controller.v
ddr4_1600_x16_map0_bounded: read -formal -DDDR4_CLK_PERIOD=1250 -DDEVICE_WIDTH=16 -DADDR_MAPPING=0 -DFORMAL_BOUNDED_STALL ddr4_controller.v
ddr4_2400_x8_row14_map1:    read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 -DROW_BITS=14 ddr4_controller.v
ddr4_2400_x8_row17_map1:    read -formal -DDDR4_CLK_PERIOD=833  -DDEVICE_WIDTH=8  -DADDR_MAPPING=1 -DROW_BITS=17 ddr4_controller.v
read -formal fwb_slave.v
read -formal mini_fifo.v
read -formal f_addr_decode.v
prep -top ddr4_controller

[files]
rtl/ddr4_controller.v
formal/ddr4_controller_formal.vh
formal/fwb_slave.v
formal/mini_fifo.v
formal/f_addr_decode.v